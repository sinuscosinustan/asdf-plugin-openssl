#!/usr/bin/env bash

export OPENSSL_DIR="$ASDF_INSTALL_PATH"
export OPENSSL_ROOT_DIR="$ASDF_INSTALL_PATH"
export OPENSSL_INCLUDE_DIR="$ASDF_INSTALL_PATH/include"
export OPENSSL_LIB_DIR="$ASDF_INSTALL_PATH/lib"
export SSL_CERT_DIR="${SSL_CERT_DIR:-$ASDF_INSTALL_PATH/ssl/certs}"

export PKG_CONFIG_PATH="$ASDF_INSTALL_PATH/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export CPPFLAGS="-I$ASDF_INSTALL_PATH/include${CPPFLAGS:+ $CPPFLAGS}"
export LDFLAGS="-L$ASDF_INSTALL_PATH/lib${LDFLAGS:+ $LDFLAGS}"

if [ "$(uname -s)" = "Darwin" ]; then
	export DYLD_LIBRARY_PATH="$ASDF_INSTALL_PATH/lib${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
else
	export LD_LIBRARY_PATH="$ASDF_INSTALL_PATH/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
